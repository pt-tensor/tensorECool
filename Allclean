#!/bin/bash
# Full clean: results + generated meshes. Restore flat 0/ from 0.orig/.
# Keeps Reports/, scripts/, 0.orig/, system/, constant thermophysical files.
# Works on the Mac host (no OpenFOAM required). Remesh with ./buildMesh.
set -euo pipefail
cd "${0%/*}" || exit 1
shopt -s nullglob

# Time folders (foamListTimes needs OpenFOAM; always wipe by name too)
if command -v foamListTimes >/dev/null 2>&1; then
    foamListTimes -rm 2>/dev/null || true
fi
for d in *; do
    [ -d "$d" ] || continue
    case "$d" in
        0|0.orig|constant|system|Reports|scripts) continue ;;
    esac
    if [[ "$d" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        rm -rf "$d"
    fi
done

rm -rf processor* postProcessing VTK dynamicCode
rm -f log.* *.foam

# Generated meshes (global + multi-region)
rm -rf \
    constant/polyMesh \
    constant/cellToRegion \
    constant/sets \
    constant/extendedFeatureEdgeMesh \
    constant/fluid/polyMesh \
    constant/PCB/polyMesh \
    constant/PBGA/polyMesh \
    constant/fluid/cellToRegion \
    constant/PCB/cellToRegion \
    constant/PBGA/cellToRegion

# Any other region mesh leftovers under constant/<region>/
for d in constant/*/polyMesh constant/*/cellToRegion constant/*/sets; do
    rm -rf "$d"
done

rm -rf 0
cp -r 0.orig 0

echo "Allclean: removed mesh + results; restored 0/ from 0.orig/"
