// Explicit patch names required: changeDictionary merge does not expand
// ".*" against the mesh when a leftover calculated ".*" key already exists
// in 0.orig, and that leftover wins on walls after decomposePar.

T
{
    internalField   uniform 300;
    boundaryField
    {
        walls
        {
            type            zeroGradient;
            value           uniform 300;
        }
        side_posX
        {
            type            zeroGradient;
            value           uniform 300;
        }
        inlet
        {
            type            fixedValue;
            value           uniform 300;
        }
        outlet
        {
            type            inletOutlet;
            inletValue      uniform 300;
            value           uniform 300;
        }
        fluid_to_PCB
        {
            type            compressible::turbulentTemperatureCoupledBaffleMixed;
            Tnbr            T;
            kappaMethod     fluidThermo;
            value           uniform 300;
        }
        fluid_to_PBGA
        {
            type            compressible::turbulentTemperatureCoupledBaffleMixed;
            Tnbr            T;
            kappaMethod     fluidThermo;
            value           uniform 300;
        }
    }
}

