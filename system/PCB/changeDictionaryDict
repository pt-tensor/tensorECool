FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

T
{
    internalField   uniform 300;
    boundaryField
    {
        walls
        {
            type            zeroGradient;
            value           uniform 300;
        }
        PCB_to_fluid
        {
            type            compressible::turbulentTemperatureCoupledBaffleMixed;
            Tnbr            T;
            kappaMethod     solidThermo;
            value           uniform 300;
        }
        PCB_to_PBGA
        {
            type            compressible::turbulentTemperatureCoupledBaffleMixed;
            Tnbr            T;
            kappaMethod     solidThermo;
            value           uniform 300;
        }
    }
}

// heSolidThermo (rhoConst) requires p in the solid regions.
p
{
    internalField   uniform 1e5;
    boundaryField
    {
        walls
        {
            type            calculated;
            value           uniform 1e5;
        }
        PCB_to_fluid
        {
            type            calculated;
            value           uniform 1e5;
        }
        PCB_to_PBGA
        {
            type            calculated;
            value           uniform 1e5;
        }
    }
}

