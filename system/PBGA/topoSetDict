FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ~15 x 15 x 0.8 mm die centred on the package, sitting on the PCB face.
// Created after splitMeshRegions with: topoSet -region PBGA
actions
(
    {
        name    dieCells;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0.0925 0.0925 0.0012) (0.1075 0.1075 0.0020);
    }
    {
        name    die;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     dieCells;
    }
);

